"use client";

import Link from "next/link";
import { useCallback, useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import { SiteShell } from "@/components/site-shell";
import { createClient } from "@/lib/supabase/client";

type Turf = {
  id: string;
  name: string;
  county: string;
  town: string;
  price_per_hour: number;
  review_status: string;
  is_active: boolean;
};

type Booking = {
  id: string;
  booking_date: string;
  start_time: string;
  end_time: string;
  status: string;
  payment_status: string;
  customer_note: string;
  turf_id: string;
};

type Subscription = {
  id: string;
  plan_name: string;
  amount: number;
  status: string;
  starts_at: string | null;
  ends_at: string | null;
};

const inputClass =
  "mt-2 min-h-12 w-full rounded-lg border border-gray-300 bg-white px-4 text-gray-950 outline-none focus:border-green-700";

export default function OwnerDashboardPage() {
  const router = useRouter();
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");
  const [turfs, setTurfs] = useState<Turf[]>([]);
  const [bookings, setBookings] = useState<Booking[]>([]);
  const [subscription, setSubscription] = useState<Subscription | null>(null);

  const [name, setName] = useState("");
  const [description, setDescription] = useState("");
  const [county, setCounty] = useState("");
  const [town, setTown] = useState("");
  const [address, setAddress] = useState("");
  const [price, setPrice] = useState("");
  const [capacity, setCapacity] = useState("10");
  const [facilities, setFacilities] = useState("");
  const [openingTime, setOpeningTime] = useState("08:00");
  const [closingTime, setClosingTime] = useState("22:00");

  const loadDashboard = useCallback(async () => {
    const supabase = createClient();
    const { data: authData, error: authError } = await supabase.auth.getUser();

    if (authError || !authData.user) {
      router.replace("/login?next=/owner/dashboard");
      return;
    }

    const { data: profile, error: profileError } = await supabase
      .from("profiles")
      .select("role")
      .eq("id", authData.user.id)
      .single();

    if (profileError) {
      setError("Could not verify your account.");
      setLoading(false);
      return;
    }

    if (profile.role === "superadmin") {
      router.replace("/admin/dashboard");
      return;
    }

    if (profile.role !== "turf_owner") {
      router.replace("/owner/apply");
      return;
    }

    const [turfResult, bookingResult, subscriptionResult] = await Promise.all([
      supabase
        .from("turfs")
        .select(
          "id, name, county, town, price_per_hour, review_status, is_active"
        )
        .eq("owner_id", authData.user.id)
        .order("created_at", { ascending: false }),

      supabase
        .from("bookings")
        .select(
          "id, turf_id, booking_date, start_time, end_time, status, payment_status, customer_note"
        )
        .order("created_at", { ascending: false })
        .limit(50),

      supabase
        .from("subscriptions")
        .select("id, plan_name, amount, status, starts_at, ends_at")
        .eq("owner_id", authData.user.id)
        .order("created_at", { ascending: false })
        .limit(1)
        .maybeSingle(),
    ]);

    if (turfResult.error) {
      setError(turfResult.error.message);
    } else {
      setTurfs((turfResult.data ?? []) as Turf[]);
    }

    if (bookingResult.error) {
      setError((previous) =>
        previous || "Could not load booking requests."
      );
    } else {
      setBookings((bookingResult.data ?? []) as Booking[]);
    }

    if (!subscriptionResult.error) {
      setSubscription(subscriptionResult.data as Subscription | null);
    }

    setLoading(false);
  }, [router]);

  useEffect(() => {
    void loadDashboard();
  }, [loadDashboard]);

  async function createTurf(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setError("");
    setNotice("");

    if (!name.trim() || !county.trim() || !town.trim() || Number(price) < 0) {
      setError("Complete the required turf fields and enter a valid price.");
      return;
    }

    const numericPrice = Number(price);
    const numericCapacity = Number(capacity);

    if (!Number.isFinite(numericPrice) || numericPrice < 0) {
      setError("Enter a valid hourly price.");
      return;
    }

    if (!Number.isInteger(numericCapacity) || numericCapacity < 1) {
      setError("Capacity must be a positive whole number.");
      return;
    }

    setSaving(true);

    try {
      const supabase = createClient();
      const { data: authData } = await supabase.auth.getUser();

      if (!authData.user) {
        router.replace("/login?next=/owner/dashboard");
        return;
      }

      const { data: profile } = await supabase
        .from("profiles")
        .select("role")
        .eq("id", authData.user.id)
        .single();

      if (profile?.role !== "turf_owner") {
        setError("Only approved turf owners can submit turf listings.");
        return;
      }

      const { error: insertError } = await supabase.from("turfs").insert({
        owner_id: authData.user.id,
        name: name.trim(),
        description: description.trim(),
        county: county.trim(),
        town: town.trim(),
        address: address.trim(),
        price_per_hour: numericPrice,
        capacity: numericCapacity,
        facilities: facilities
          .split(",")
          .map((item) => item.trim())
          .filter(Boolean),
        opening_time: openingTime,
        closing_time: closingTime,
        review_status: "pending",
        is_active: false,
      });

      if (insertError) {
        setError(insertError.message);
        return;
      }

      setNotice("Turf submitted. It must be approved before public discovery.");
      setName("");
      setDescription("");
      setCounty("");
      setTown("");
      setAddress("");
      setPrice("");
      setFacilities("");
      await loadDashboard();
    } catch {
      setError("Could not submit the turf. Please try again.");
    } finally {
      setSaving(false);
    }
  }

  if (loading) {
    return (
      <SiteShell>
        <div className="mx-auto max-w-7xl px-5 py-16 text-gray-600">
          Loading owner dashboard...
        </div>
      </SiteShell>
    );
  }

  return (
    <SiteShell>
      <section className="bg-green-950 text-white">
        <div className="mx-auto max-w-7xl px-5 py-12">
          <p className="text-sm font-bold uppercase tracking-wider text-green-300">
            Turf owner workspace
          </p>
          <h1 className="mt-3 text-4xl font-black">Owner dashboard</h1>
          <p className="mt-3 max-w-2xl leading-7 text-green-100">
            Manage your turf listings, track booking requests, and check your
            subscription status.
          </p>
        </div>
      </section>

      <section className="mx-auto max-w-7xl space-y-12 px-5 py-10">
        {error && (
          <div role="alert" className="rounded-lg border border-red-200 bg-red-50 p-4 text-red-900">
            {error}
          </div>
        )}

        {notice && (
          <div role="status" className="rounded-lg border border-green-200 bg-green-50 p-4 text-green-950">
            {notice}
          </div>
        )}

        <div className="grid gap-4 sm:grid-cols-3">
          <div className="rounded-xl border border-gray-200 p-6">
            <p className="text-sm text-gray-600">Total turf listings</p>
            <p className="mt-2 text-3xl font-black text-gray-950">{turfs.length}</p>
          </div>
          <div className="rounded-xl border border-gray-200 p-6">
            <p className="text-sm text-gray-600">Pending turf approvals</p>
            <p className="mt-2 text-3xl font-black text-gray-950">
              {turfs.filter((t) => t.review_status === "pending").length}
            </p>
          </div>
          <div className="rounded-xl border border-gray-200 p-6">
            <p className="text-sm text-gray-600">Booking requests visible</p>
            <p className="mt-2 text-3xl font-black text-gray-950">{bookings.length}</p>
          </div>
        </div>

        <section>
          <h2 className="text-2xl font-black text-gray-950">Subscription</h2>
          {subscription ? (
            <div className="mt-4 rounded-xl border border-gray-200 p-6">
              <p className="font-bold text-gray-950">{subscription.plan_name}</p>
              <p className="mt-2 text-sm text-gray-600">
                Amount: KSh {Number(subscription.amount).toLocaleString("en-KE")}
              </p>
              <p className="mt-1 text-sm text-gray-600">
                Status: <span className="font-semibold">{subscription.status}</span>
              </p>
              {subscription.ends_at && (
                <p className="mt-1 text-sm text-gray-600">
                  Ends: {new Date(subscription.ends_at).toLocaleDateString("en-KE")}
                </p>
              )}
            </div>
          ) : (
            <div className="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-6">
              <p className="font-bold text-amber-950">No subscription found</p>
              <p className="mt-2 text-sm leading-6 text-amber-900">
                Contact the TURFF administrator to arrange and verify your
                monthly subscription. Booking requests must remain disabled
                until an active subscription is confirmed.
              </p>
              <Link
                href="/pricing"
                className="mt-4 inline-flex min-h-11 items-center justify-center rounded-lg bg-green-800 px-5 font-bold text-white hover:bg-green-900"
              >
                View owner pricing
              </Link>
            </div>
          )}
        </section>

        <section>
          <h2 className="text-2xl font-black text-gray-950">Your turfs</h2>
          {turfs.length === 0 ? (
            <p className="mt-4 rounded-xl border border-gray-200 p-6 text-gray-600">
              You have not submitted any turf listings yet.
            </p>
          ) : (
            <div className="mt-4 grid gap-4 md:grid-cols-2">
              {turfs.map((turf) => (
                <article key={turf.id} className="rounded-xl border border-gray-200 p-6">
                  <div className="flex flex-wrap items-start justify-between gap-3">
                    <h3 className="text-xl font-bold text-gray-950">{turf.name}</h3>
                    <span className="rounded-md bg-gray-100 px-3 py-1 text-sm font-semibold text-gray-800">
                      {turf.review_status}
                    </span>
                  </div>
                  <p className="mt-2 text-sm text-gray-600">
                    {[turf.town, turf.county].filter(Boolean).join(", ")}
                  </p>
                  <p className="mt-3 font-bold text-green-800">
                    KSh {Number(turf.price_per_hour).toLocaleString("en-KE")} / hour
                  </p>
                  <p className="mt-2 text-sm text-gray-600">
                    {turf.is_active ? "Active" : "Not active"}
                  </p>
                </article>
              ))}
            </div>
          )}
        </section>

        <section>
          <h2 className="text-2xl font-black text-gray-950">Booking requests</h2>
          <p className="mt-2 text-sm leading-6 text-gray-600">
            Booking status changes must be handled by an authorized server-side
            operation. This dashboard displays requests but does not bypass
            the database's booking-update protections.
          </p>
          {bookings.length === 0 ? (
            <p className="mt-4 rounded-xl border border-gray-200 p-6 text-gray-600">
              No booking requests are available yet.
            </p>
          ) : (
            <div className="mt-4 space-y-3">
              {bookings.map((booking) => (
                <article key={booking.id} className="rounded-xl border border-gray-200 p-5">
                  <div className="flex flex-wrap justify-between gap-3">
                    <p className="font-bold text-gray-950">
                      {booking.booking_date} · {booking.start_time}–{booking.end_time}
                    </p>
                    <p className="text-sm text-gray-600">
                      {booking.status} / {booking.payment_status}
                    </p>
                  </div>
                  {booking.customer_note && (
                    <p className="mt-2 text-sm text-gray-600">{booking.customer_note}</p>
                  )}
                </article>
              ))}
            </div>
          )}
        </section>

        <section>
          <h2 className="text-2xl font-black text-gray-950">Submit a new turf</h2>
          <p className="mt-2 text-gray-600">
            Every new listing is submitted for administrator approval.
          </p>

          <form onSubmit={createTurf} className="mt-5 grid gap-5 rounded-xl border border-gray-200 p-6 sm:grid-cols-2">
            <div>
              <label htmlFor="name" className="font-semibold text-gray-900">Turf name *</label>
              <input id="name" value={name} onChange={(e) => setName(e.target.value)} required maxLength={150} className={inputClass} />
            </div>
            <div>
              <label htmlFor="price" className="font-semibold text-gray-900">Price per hour (KSh) *</label>
              <input id="price" type="number" min="0" step="1" value={price} onChange={(e) => setPrice(e.target.value)} required className={inputClass} />
            </div>
            <div>
              <label htmlFor="county" className="font-semibold text-gray-900">County *</label>
              <input id="county" value={county} onChange={(e) => setCounty(e.target.value)} required maxLength={100} className={inputClass} />
            </div>
            <div>
              <label htmlFor="town" className="font-semibold text-gray-900">Town or estate *</label>
              <input id="town" value={town} onChange={(e) => setTown(e.target.value)} required maxLength={100} className={inputClass} />
            </div>
            <div className="sm:col-span-2">
              <label htmlFor="address" className="font-semibold text-gray-900">Physical address</label>
              <input id="address" value={address} onChange={(e) => setAddress(e.target.value)} maxLength={250} className={inputClass} />
            </div>
            <div className="sm:col-span-2">
              <label htmlFor="description" className="font-semibold text-gray-900">Description</label>
              <textarea id="description" value={description} onChange={(e) => setDescription(e.target.value)} rows={3} maxLength={3000} className={inputClass} />
            </div>
            <div>
              <label htmlFor="capacity" className="font-semibold text-gray-900">Player capacity</label>
              <input id="capacity" type="number" min="1" step="1" value={capacity} onChange={(e) => setCapacity(e.target.value)} className={inputClass} />
            </div>
            <div>
              <label htmlFor="facilities" className="font-semibold text-gray-900">Facilities</label>
              <input id="facilities" value={facilities} onChange={(e) => setFacilities(e.target.value)} className={inputClass} placeholder="Parking, changing rooms, lights" />
            </div>
            <div>
              <label htmlFor="openingTime" className="font-semibold text-gray-900">Opening time</label>
              <input id="openingTime" type="time" value={openingTime} onChange={(e) => setOpeningTime(e.target.value)} required className={inputClass} />
            </div>
            <div>
              <label htmlFor="closingTime" className="font-semibold text-gray-900">Closing time</label>
              <input id="closingTime" type="time" value={closingTime} onChange={(e) => setClosingTime(e.target.value)} required className={inputClass} />
            </div>
            <div className="sm:col-span-2">
              <button type="submit" disabled={saving} className="inline-flex min-h-12 w-full items-center justify-center rounded-lg bg-green-800 px-6 font-bold text-white hover:bg-green-900 disabled:opacity-60">
                {saving ? "Submitting..." : "Submit turf for approval"}
              </button>
            </div>
          </form>
        </section>
      </section>
    </SiteShell>
  );
}
